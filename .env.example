DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cloudbreak
REDIS_URL=redis://localhost:6379
WEATHER_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
POSTHOG_API_KEY=
# Push Expo : token d'accès Expo (expo.dev → Account → Access tokens). Optionnel en dev, à poser en prod.
EXPO_ACCESS_TOKEN=
# Jobs internes (alertes favoris Premium). Secret du cron : openssl rand -hex 32 (32 caractères minimum).
# Vide ou trop court = endpoints /internal/* désactivés (503). Ne jamais le committer ni le mettre dans une URL.
# Appel (1 fois par soir, ~18:00 Europe/Paris, avant minuit : la cible est « demain 6h ») :
#   curl -m 120 -X POST -H "X-Cron-Secret: $INTERNAL_CRON_SECRET" https://<host>/internal/notifications/run-favorites
INTERNAL_CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=  # Supabase Dashboard → Settings → API → service_role secret (jamais exposé côté client)
ENVIRONMENT=development

# Apple StoreKit 2 public identifiers. Keep the private .p8 key outside the repository.
APPLE_BUNDLE_ID=com.alexandremoreau.cloudbreak
APPLE_ENVIRONMENT=Sandbox
APPLE_APP_ID=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY_PATH=

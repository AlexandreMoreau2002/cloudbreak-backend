DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cloudbreak
REDIS_URL=redis://localhost:6379
WEATHER_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
POSTHOG_API_KEY=
# Push Expo : token d'accès Expo (expo.dev → Account → Access tokens). Optionnel en dev, à poser en prod.
EXPO_ACCESS_TOKEN=
# Jobs internes (alertes favoris Premium). Secret du cron : openssl rand -hex 32 (32 caractères minimum).
# Vide ou trop court = endpoints /internal/* désactivés (503). Ne jamais le committer ni le mettre dans une URL.
# Appel (1 fois par soir, ~18:00 Europe/Paris, avant minuit : la cible est « demain 6h ») :
#   curl -m 120 -X POST -H "X-Cron-Secret: $INTERNAL_CRON_SECRET" https://<host>/internal/notifications/run-favorites
INTERNAL_CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=  # Supabase Dashboard → Settings → API → service_role secret (jamais exposé côté client)
# Purge des comptes anonymes inactifs (POST /internal/maintenance/purge-anonymous, protégé par
# INTERNAL_CRON_SECRET, exige SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY sinon 503).
# Un user_id sans ligne `users` et sans activité (predictions, terrain_validations, user_favorites)
# depuis ANON_RETENTION_DAYS jours est supprimé, seulement si Supabase confirme is_anonymous=true.
# ANON_PURGE_MAX_PER_RUN plafonne le nombre de comptes traités par appel (les plus anciens d'abord).
# Appel (1 fois par jour, 06:00 Europe/Paris, après la sauvegarde de 03:00 UTC ; tester d'abord avec ?dry_run=true) :
#   curl -m 300 -X POST -H "X-Cron-Secret: $INTERNAL_CRON_SECRET" https://<host>/internal/maintenance/purge-anonymous
ANON_RETENTION_DAYS=30
ANON_PURGE_MAX_PER_RUN=200
ENVIRONMENT=development

# Apple StoreKit 2 public identifiers. Keep the private .p8 key outside the repository.
APPLE_BUNDLE_ID=com.alexandremoreau.cloudbreak
APPLE_ENVIRONMENT=Sandbox
APPLE_APP_ID=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY_PATH=

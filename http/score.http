# Score mer de nuage — tests manuels
#
# Prérequis dans .vscode/settings.json > rest-client.environmentVariables > local :
#   "baseUrl": "http://localhost:8000"
#   "jwt": "<token Supabase — copié depuis les logs mobile>"
#
# IDs disponibles après `make seed` :
#   Puy de Dôme         : 11111111-0000-0000-0000-000000000001  (1465m)
#   Mont Ventoux        : 11111111-0000-0000-0000-000000000002  (1912m)
#   Crêt de la Neige    : 11111111-0000-0000-0000-000000000003  (1720m)
#   Grand Ballon        : 11111111-0000-0000-0000-000000000004  (1424m)
#   Ballon d'Alsace     : 11111111-0000-0000-0000-000000000005  (1247m)
#   Pic Saint-Loup      : 11111111-0000-0000-0000-000000000006  (658m)
#   Mont Salève         : 11111111-0000-0000-0000-000000000007  (1379m)
#   Roc'h Trevezel      : 11111111-0000-0000-0000-000000000008  (384m)
#   Pic du Midi Bigorre : 11111111-0000-0000-0000-000000000009  (2877m)
#   Mont Aigoual        : 11111111-0000-0000-0000-000000000010  (1567m)

###
# ✅ Score Puy de Dôme — heure par défaut (6h matin, idéal mer de nuage)
GET {{baseUrl}}/api/v1/score?peak_id=11111111-0000-0000-0000-000000000001&date=2026-03-22
Authorization: Bearer {{jwt}}

###
# ✅ Score Puy de Dôme — heure personnalisée (8h)
GET {{baseUrl}}/api/v1/score?peak_id=11111111-0000-0000-0000-000000000001&date=2026-03-22&hour=8
Authorization: Bearer {{jwt}}

###
# ✅ Score Mont Ventoux
GET {{baseUrl}}/api/v1/score?peak_id=11111111-0000-0000-0000-000000000002&date=2026-03-22
Authorization: Bearer {{jwt}}

###
# ✅ Score Crêt de la Neige (Jura — très favorable mer de nuage)
GET {{baseUrl}}/api/v1/score?peak_id=11111111-0000-0000-0000-000000000003&date=2026-03-22
Authorization: Bearer {{jwt}}

###
# ✅ Score Pic du Midi de Bigorre (2877m — haut, rare)
GET {{baseUrl}}/api/v1/score?peak_id=11111111-0000-0000-0000-000000000009&date=2026-03-22
Authorization: Bearer {{jwt}}

###
# ✅ Score Roc'h Trevezel (384m — Bretagne, altitude basse)
GET {{baseUrl}}/api/v1/score?peak_id=11111111-0000-0000-0000-000000000008&date=2026-03-22
Authorization: Bearer {{jwt}}

###
# ❌ Sans JWT → 401
GET {{baseUrl}}/api/v1/score?peak_id=11111111-0000-0000-0000-000000000001&date=2026-03-22

###
# ❌ Token invalide → 401
GET {{baseUrl}}/api/v1/score?peak_id=11111111-0000-0000-0000-000000000001&date=2026-03-22
Authorization: Bearer token.invalide.ici

###
# ❌ Peak introuvable → 404
GET {{baseUrl}}/api/v1/score?peak_id=00000000-0000-0000-0000-000000000000&date=2026-03-22
Authorization: Bearer {{jwt}}

###
# ❌ Date manquante → 422
GET {{baseUrl}}/api/v1/score?peak_id=11111111-0000-0000-0000-000000000001
Authorization: Bearer {{jwt}}

###
# ❌ Heure hors limites (hour=25) → 422
GET {{baseUrl}}/api/v1/score?peak_id=11111111-0000-0000-0000-000000000001&date=2026-03-22&hour=25
Authorization: Bearer {{jwt}}
